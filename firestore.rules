
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorizedUser(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches(
          '^[a-z0-9._%+-]+@hbplus[.]fit$'
        );
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches(
          '^[a-z0-9._%+-]+@hbplus[.]fit$'
        );
    }

    function validTask() {
      return request.resource.data.keys().hasAll([
          'title',
          'description',
          'priority',
          'dueDate',
          'completed',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title',
          'description',
          'priority',
          'dueDate',
          'completed',
          'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.priority in ['Low', 'Medium', 'High']
        && request.resource.data.dueDate is string
        && request.resource.data.completed is bool
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if isAuthorizedUser(userId) || isAdmin();

      allow create: if isAuthorizedUser(userId)
        && validTask();

      allow update: if isAuthorizedUser(userId)
        && validTask()
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAuthorizedUser(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
